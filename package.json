{
  "name": "meridian-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A physics lab adventure for study breaks, with a hard study lock.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-single-file.mjs",
    "build:test": "vite build --mode testbuild --outDir dist-test",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/e2e/run.cjs"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
